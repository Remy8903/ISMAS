FROM mariadb:11.4

RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-psutil \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /var/log/mysql && chown mysql:mysql /var/log/mysql

COPY ismas.cnf            /etc/mysql/conf.d/ismas.cnf
COPY ismas-entrypoint.sh  /usr/local/bin/ismas-entrypoint.sh
RUN chmod +x /usr/local/bin/ismas-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/ismas-entrypoint.sh"]
CMD ["mariadbd"]
