# cp .env.example .env  (never commit .env)
# Tailscale MagicDNS name of the brain, e.g. brain.tail1234.ts.net  (tailscale status)
TS_HOSTNAME=brain.your-tailnet.ts.net
# Version you tested locally: docker exec n8n-local n8n --version
N8N_VERSION=1.0.0
# generate: openssl rand -hex 32
AGENT_TOKEN=
POSTGRES_PASSWORD=
TELEGRAM_CHAT_ID=
